model Property {

  id              String          @id @default(uuid())

  landlordId      String

  title           String

  description     String


  latitude        Float?

  longitude       Float?


  county          String

  town            String

  estate          String

  address         String?



  propertyType    PropertyType


  bedrooms        Int

  bathrooms       Int



  parking         Boolean @default(false)

  furnished       Boolean @default(false)

  wifi            Boolean @default(false)

  cctv            Boolean @default(false)

  balcony         Boolean @default(false)

  borehole        Boolean @default(false)

  security        Boolean @default(false)

  swimmingPool    Boolean @default(false)

  lift            Boolean @default(false)

  petsAllowed     Boolean @default(false)

  backupGenerator Boolean @default(false)



  rent            Decimal @db.Decimal(12,2)

  deposit         Decimal @db.Decimal(12,2)



  status          PropertyStatus @default(AVAILABLE)


  verified        Boolean @default(false)


  views           Int @default(0)



  createdAt       DateTime @default(now())

  updatedAt       DateTime @updatedAt



  landlord        User @relation(
    fields:[landlordId],
    references:[id],
    onDelete:Cascade
  )



  images           PropertyImage[]

  favorites        Favorite[]

  reviews          Review[]

  visits           VisitRequest[]

  messages         Message[]



  @@index([landlordId])

  @@index([county])

  @@index([town])

  @@index([estate])

  @@index([rent])

  @@index([status])

  @@index([propertyType])

}