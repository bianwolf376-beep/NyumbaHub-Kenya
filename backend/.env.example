# Server Configuration
PORT=3001
NODE_ENV=development

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nyumbahub?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/nyumbahub?schema=public"

# Frontend URL (for CORS)
FRONTEND_URL="http://localhost:3000"

# JWT Configuration
JWT_SECRET="NyumbaHubSecretKey2026"
JWT_EXPIRATION="7d"

# Supabase Configuration
SUPABASE_URL="your_supabase_url"
SUPABASE_KEY="your_supabase_key"

# M-Pesa Daraja Configuration (Optional for Phase 2)
MPESA_CONSUMER_KEY="your_mpesa_consumer_key"
MPESA_CONSUMER_SECRET="your_mpesa_consumer_secret"
MPESA_BUSINESS_SHORT_CODE="your_business_short_code"
MPESA_PASSKEY="your_passkey"

# Email Configuration (Optional for notifications)
MAIL_HOST="smtp.gmail.com"
MAIL_PORT=587
MAIL_USER="your_email@gmail.com"
MAIL_PASSWORD="your_app_password"
MAIL_FROM="noreply@nyumbahub.com"

# OpenAI Configuration (Optional for AI features)
OPENAI_API_KEY="your_openai_api_key"
